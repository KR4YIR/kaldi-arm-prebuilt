# Build artifacts (source/object files in bin/)
bin/*.o
bin/*.cc
bin/Makefile

# Prebuilt shared libraries (.so) ARE tracked - do NOT ignore lib/
# Static libraries (.a) are excluded (too large for GitHub, not needed at runtime)
*.a

# General build artifacts (outside lib/)
*.dylib
*.dll
*.def
*.res
*.gcno
*.gcda
*.exe

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Node
node_modules/
npm-debug.log

# OS files
Thumbs.db
.directory

# Build directories
cmake-build-debug/
cmake-build-release/
out/

# Log files
*.log
*.err
